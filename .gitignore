node_modules/
dist/
*.tsbuildinfo
.DS_Store

# Every skill folder here is fetched by scripts/vendor-skills.js from the repos
# listed in skills/skills.yaml, pinned in skills/skills.lock.json. They are not
# kept in git — patch them upstream, in the repo that owns them. The release
# workflow fetches them again before publishing, so the npm package ships them.
#
# These rules live at the repo root on purpose: an ignore file INSIDE skills/
# would also hide the tree from the agent, whose skill discovery honours
# .gitignore in every directory it walks.
skills/*
!skills/skills.yaml
!skills/skills.lock.json
