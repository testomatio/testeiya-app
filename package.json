{
  "name": "testeiya-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "git submodule update --init --recursive",
    "update": "git pull origin main && bun install && git submodule update --remote --init testeiya && cd testeiya && bun install",
    "dev": "concurrently -n web,agent -c cyan,magenta \"next dev -p 3050\" \"cd testeiya && PORT=3210 bun run serve:app:watch\"",
    "build": "NEXT_EXPORT=1 next build",
    "desktop:dev": "NEXT_EXPORT=1 next build && GLIBC_TUNABLES=glibc.rtld.optional_static_tls=20480 electrobun dev",
    "desktop:build": "bash .github/packaging/pre-desktop-build.sh && NEXT_EXPORT=1 next build && electrobun build",
    "desktop:release": "bash .github/packaging/pre-desktop-build.sh && NEXT_EXPORT=1 next build && electrobun build --env=stable && bash .github/packaging/fix-macos-minos.sh",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "update:agent": "git submodule update --remote testeiya && git add testeiya && git commit -m \"chore: bump Testeiya Agent\""
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.5"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@blocknote/core": "^0.31.3",
    "@blocknote/mantine": "^0.31.3",
    "@blocknote/react": "^0.31.3",
    "@floating-ui/react": "^0.27.19",
    "@mdi/js": "^7.4.47",
    "@radix-ui/react-use-controllable-state": "^1.2.3",
    "@rive-app/react-webgl2": "^4.29.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@xyflow/react": "^12.11.0",
    "ai": "^6.0.199",
    "ansi-to-react": "^6.2.6",
    "check-tests": "^0.15.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^9.2.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.17.0",
    "media-chrome": "^4.19.1",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "motion": "^12.40.0",
    "nanoid": "^5.1.11",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-jsx-parser": "^2.4.1",
    "shadcn": "^4.11.0",
    "shiki": "^4.2.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "testomatio-editor-blocks": "^0.4.71",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20.19.42",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electrobun": "^1.18.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3"
  }
}
