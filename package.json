{
  "name": "testeiya",
  "version": "0.3.2",
  "description": "AI testing agent — QA-focused coding agent for manual and automated tests",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/testomatio/testeiya-app.git"
  },
  "homepage": "https://github.com/testomatio/testeiya-app#readme",
  "bin": {
    "testeiya": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "prompt",
    "pipelines",
    "PIPELINES.md",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "npm run build && node dist/src/cli.js",
    "dev": "./testeiya",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.js"
  },
  "keywords": [
    "testing",
    "qa",
    "ai",
    "agent",
    "testomatio",
    "pi"
  ],
  "dependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@testomatio/mcp": "^3.1.0",
    "chalk": "^5.6.2",
    "dedent": "^1.7.2",
    "liquidjs": "^10.30.0",
    "pi-subagents": "^0.81.0",
    "typebox": "1.3.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
