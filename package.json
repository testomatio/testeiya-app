{
  "name": "testeiya",
  "version": "0.3.2",
  "description": "AI testing agent \u2014 QA-focused coding agent for manual and automated tests",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/testomatio/testeiya-app.git"
  },
  "homepage": "https://github.com/testomatio/testeiya-app#readme",
  "bin": {
    "testeiya": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "prompt",
    "skills",
    "mcp-tools.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "npm run build && node dist/src/cli.js",
    "build": "tsc -p tsconfig.json && npm run build:vendor",
    "build:vendor": "esbuild scripts/vendor-entry.ts --bundle --format=esm --platform=node --packages=external --outfile=dist/vendor/mcp.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.js"
  },
  "keywords": [
    "testing",
    "qa",
    "ai",
    "agent",
    "testomatio",
    "pi"
  ],
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@testomatio/mcp": "^2.1.1",
    "chalk": "^5.6.2",
    "dedent": "^1.7.2",
    "pi-mcp-adapter": "^2.21.1",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  }
}
